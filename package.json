{
  "name": "@react-native-ohos/react-native-bidirectional-flatlist",
  "displayName": "ReactNativeBidirectionalFlatlist",
  "version": "0.6.0",
  "description": "A FlatList which can handle prepending and appending and still holding the current position",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "types": "./src/index.tsx",
  "license": "MIT",
  "private": false,
  "repository": "https://github.com/steuerbot/react-native-bidirectional-flatlist",
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/steuerbot/react-native-bidirectional-flatlist#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/",
    "README.md",
    "README_en.md",
    "CHANGELOG.md",
    "LICENSE",
    "!src/**/__tests__",
    "!src/specs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-bidirectional-flatlist"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
